<%
  // Course card. Params: c (course object), level (heading level, default 3)
  const _h = typeof level !== 'undefined' ? level : 3;
  const url = './course-details.html?id=' + c.id;
  const titleId = 'course-' + c.id + '-' + (typeof idSuffix !== 'undefined' ? idSuffix : 'card');
-%>
<article class="course-card" aria-labelledby="<%= titleId %>" data-course-id="<%= c.id %>" itemscope itemtype="https://schema.org/Course">
  <div class="course-card__media">
    <%- include('picture', { name: 'covers/' + c.cat, alt: '', widths: [400, 800], sizes: '(min-width: 1280px) 262px, (min-width: 768px) 45vw, 100vw', width: 400, height: 226, block: 'course-card' }) %>
<% if (c.tag) { -%>
    <span class="course-card__tag tag tag--<%= c.tag.toLowerCase() %>"><%= c.tag %></span>
<% } -%>
    <button class="course-card__bookmark" type="button" aria-pressed="false" aria-label="Save “<%= c.title %>” to wishlist">
      <svg class="course-card__bookmark-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 21l-6-4.5L6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
    </button>
  </div>
  <div class="course-card__body">
    <p class="course-card__meta">
      <span class="course-card__level badge badge--<%= c.level.toLowerCase() %>"><%= c.level %></span>
      <span class="course-card__category" itemprop="about"><%= c.category %></span>
    </p>
    <h<%= _h %> class="course-card__title" id="<%= titleId %>" itemprop="name">
      <a class="course-card__link" href="<%= url %>" itemprop="url"><%= c.title %></a>
    </h<%= _h %>>
    <meta itemprop="description" content="<%= c.level %> <%= c.category %> course by <%= c.instructor %>, <%= c.hours %> hours, <%= c.lessons %> lessons." />
    <p class="course-card__instructor">by <span itemprop="author" itemscope itemtype="https://schema.org/Person"><span itemprop="name"><%= c.instructor %></span></span></p>
    <span itemprop="provider" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="Learnova" /></span>
    <p class="course-card__stats">
      <span class="course-card__rating rating" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
        <span class="visually-hidden">Rating: </span><span itemprop="ratingValue"><%= c.rating %></span><span class="visually-hidden"> out of 5</span>
        <meta itemprop="bestRating" content="5" />
        <meta itemprop="ratingCount" content="<%= c.reviews %>" />
        <span class="rating__count">(<%= site.formatNumber(c.reviews) %><span class="visually-hidden"> reviews</span>)</span>
      </span>
      <span class="course-card__duration"><time datetime="PT<%= c.hours %>H"><%= c.hours %> h</time></span>
    </p>
    <p class="course-card__footer">
      <span class="course-card__price price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <meta itemprop="priceCurrency" content="USD" />
        <meta itemprop="category" content="<%= c.price === 0 ? 'Free' : 'Paid' %>" />
        <data class="price__current" itemprop="price" value="<%= c.price %>"><%= site.formatPrice(c.price) %></data>
<% if (c.oldPrice) { -%>
        <s class="price__old"><span class="visually-hidden">Old price: </span>$<%= c.oldPrice %></s>
<% } -%>
      </span>
      <span class="course-card__lessons"><%= c.lessons %> lessons</span>
    </p>
  </div>
</article>
