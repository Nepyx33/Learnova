  <footer class="footer">
    <div class="footer__inner container">
      <section class="footer__brand" aria-labelledby="footer-about-title">
        <h2 class="footer__title visually-hidden" id="footer-about-title" data-i18n="footer.about">About Learnova</h2>
        <a class="footer__logo logo logo--inverse" href="./index.html" aria-label="Learnova, home page" data-i18n-aria-label="header.homeLink">
          <svg class="logo__mark" width="36" height="36" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
            <rect width="36" height="36" rx="10" fill="#4F46E5" />
            <path d="M13 10v16h11" stroke="#FFFFFF" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="27" cy="9" r="3.5" fill="#FFB020" />
          </svg>
          <span class="logo__text">Learnova</span>
        </a>
        <p class="footer__text" data-i18n="footer.tagline">Project-based IT courses from practicing engineers. Learn at your own pace and build a portfolio employers notice.</p>
      </section>

      <nav class="footer__nav" aria-label="Footer" data-i18n-aria-label="footer.navLabel">
<% site.footerLinks.forEach(function (group) { -%>
        <div class="footer__column">
          <h2 class="footer__heading" data-i18n="<%= group.i18n %>"><%= group.title %></h2>
          <ul class="footer__list">
<% group.links.forEach(function (link) { -%>
            <li class="footer__item"><a class="footer__link" href="<%= link[1] %>"><%= link[0] %></a></li>
<% }); -%>
          </ul>
        </div>
<% }); -%>
      </nav>

      <div class="footer__bottom">
        <p class="footer__copy"><small data-i18n="footer.copyright">© 2026 Learnova. Student project, all data is fictional.</small></p>
        <p class="footer__author"><small>Tsyba Yurii, KN-41 · Lab 2</small></p>
      </div>
    </div>
  </footer>
